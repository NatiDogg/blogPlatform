model User{
    id String @id @default(uuid())
    name String
    email String @unique
    password String
    role Role @default(USER)
    comments Comment[]
    deletedAt DateTime?
    author Author?
    admin Admin?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    

}


enum Role {
    USER
    AUTHOR
    ADMIN

}